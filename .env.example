## Variables de Entorno Backend

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=evaluacion_db

# Servidor
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=JWT_SECRET
JWT_EXPIRY=7d

# Authgear
AUTHGEAR_ENDPOINT=AUTHGEAR_ENDPOINT
AUTHGEAR_CLIENT_ID=AUTHGEAR_CLIENT_ID
AUTHGEAR_CLIENT_SECRET=AUTHGEAR_CLIENT_SECRET
AUTHGEAR_API_KEY=AUTHGEAR_API_KEY

# CORS
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug
