# ============================================================
# CONFIGURACIÓN DE ENTORNO
# ============================================================
# Copiar a .env y modificar según necesidad

# ============================================================
# ENTORNO DE EJECUCIÓN
# ============================================================
NODE_ENV=development

# ============================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND
# ============================================================
BACKEND_PORT=3000
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
LOG_LEVEL=debug

# ============================================================
# CONFIGURACIÓN DE BASE DE DATOS MySQL
# ============================================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=evaluacion_platform
DB_USER=evaluacion_user
DB_PASSWORD=evaluacion_password
DB_ROOT_PASSWORD=root_password_dev

# Pool de conexiones
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# ============================================================
# CONFIGURACIÓN DE AUTENTICACIÓN
# ============================================================
# JWT
JWT_SECRET=your-secret-key-change-in-production-12345
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRATION=30d

# Authgear (Integración futura)
AUTHGEAR_ENDPOINT=http://localhost:9000
AUTHGEAR_CLIENT_ID=
AUTHGEAR_CLIENT_SECRET=
AUTHGEAR_API_KEY=

# ============================================================
# CONFIGURACIÓN DE EMAIL
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@evaluacion.local

# ============================================================
# CONFIGURACIÓN DE EJECUCIÓN (Para futuros servicios)
# ============================================================
EXECUTION_SERVICE_URL=http://execution-service:3001
MAX_EXECUTION_TIME=5
MAX_MEMORY_MB=256
MAX_CONCURRENT_EXECUTIONS=10

# ============================================================
# CONFIGURACIÓN DE STORAGE
# ============================================================
# Local storage o S3
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# Para S3 (futuro)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# ============================================================
# PUERTOS DE SERVICIOS
# ============================================================
PHPMYADMIN_PORT=8080
EXECUTION_SERVICE_PORT=3001
FRONTEND_PORT=3001

# ============================================================
# OPCIONES DE DESARROLLO
# ============================================================
# Debug mode
DEBUG=evaluacion:*

# CORS
CORS_ORIGIN=http://localhost:3001

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# FIN DE CONFIGURACIÓN
# ============================================================
