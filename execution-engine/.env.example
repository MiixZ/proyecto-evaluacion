# Execution Engine - .env.example
# Variables mínimas necesarias para ejecutar el servicio de ejecución (sandbox)

NODE_ENV=development
PORT=3001

# API key requerida por la plataforma para autorizar llamadas al motor de ejecución
EXECUTION_ENGINE_API_KEY=your-secret-api-key-here

# Docker / sandbox configuration
DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_NETWORK=evaluacion-net
SANDBOX_VOLUME_NAME=evaluacion-shared-vol
MAX_CONCURRENT_CONTAINERS=10
CONTAINER_TIMEOUT_SECONDS=30

LOG_LEVEL=info
# Habilitar logs de debug
ENABLE_DEBUG_LOGS=true

# Nombres de imágenes de sandbox (puedes personalizarlas si usas imágenes propias)
SANDBOX_IMAGE_PYTHON=evaluacion-sandbox-python:latest
SANDBOX_IMAGE_JAVA=openjdk:17-slim
SANDBOX_IMAGE_JAVASCRIPT=node:18-alpine
SANDBOX_IMAGE_CPP=gcc:12-alpine

# Límites por contenedor
DEFAULT_CPU_SHARES=1024
DEFAULT_MEMORY_LIMIT_MB=512
DEFAULT_TIME_LIMIT_SECONDS=5
MAX_PROCESSES=100

# Cleanup & maintenance
# Edad máxima de contenedores huérfanos antes de limpiar (minutos)
ORPHANED_CONTAINER_MAX_AGE_MINUTES=5
# Intervalo de limpieza automática (segundos)
CLEANUP_INTERVAL_SECONDS=300

# Opciones de métricas / monitoring
ENABLE_METRICS=false
METRICS_PORT=9090

# Storage
# Directorio temporal para archivos de código
TEMP_CODE_DIR=/tmp/sandbox
# Directorio de logs de ejecución
EXECUTION_LOGS_DIR=/var/log/execution-engine
