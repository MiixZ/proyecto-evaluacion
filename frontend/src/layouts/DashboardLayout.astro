---
import Layout from "./Layout.astro";
import { Sidebar } from "@/components/layouts/Sidebar";
import { Bell } from "lucide-react";

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;
---

<Layout title={title}>
  <div class="min-h-screen bg-background flex">
    {/* Sidebar (Renderizado por React) */}
    <Sidebar client:only="react" currentPath={currentPath} />

    {/* Contenido Principal */}
    <main class="flex-1 ml-16 md:ml-64 transition-all duration-300">
      {/* Header Estático (Renderizado por Astro) */}
      <header
        class="h-16 border-b border-border bg-card/50 backdrop-blur-sm flex items-center justify-between px-6 sticky top-0 z-30">
        <h1 class="text-lg font-semibold text-foreground">
          {title}
        </h1>
        <div class="flex items-center gap-4">
          <button
            class="relative p-2 rounded-lg hover:bg-muted/20 text-muted-foreground transition-colors">
            <Bell className="h-5 w-5" />
            <span
              class="absolute top-1 right-1 h-2 w-2 bg-destructive rounded-full"
            ></span>
          </button>
        </div>
      </header>

      {/* Contenido de la página */}
      <div class="p-6 fade-in">
        <slot />
      </div>
    </main>
  </div>
</Layout>

<style>
  .fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
