---
import Layout from "../layouts/Layout.astro"; // O AuthLayout si lo prefieres
import { LoginForm } from "../components/auth/LoginForm";
import { LanguageSelector } from "../components/common/LanguageSelector";
---

<Layout title="Acceso | Plataforma de Evaluación">
  <div
    class="container relative h-screen flex-col items-center justify-center grid lg:max-w-none lg:grid-cols-2 lg:px-0">
    {/* Panel Izquierdo (Decorativo) */}
    <div
      class="relative hidden h-full flex-col bg-muted p-10 text-white dark:border-r lg:flex">
      <div class="absolute inset-0 bg-zinc-900"></div>
      <div class="relative z-20 flex items-center text-lg font-medium">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mr-2 h-6 w-6">
          <path
            d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"
          ></path>
        </svg>
        Plataforma TFM
      </div>
      <div class="relative z-20 mt-auto">
        <blockquote class="space-y-2">
          <p class="text-lg">
            "Plataforma educativa de evaluación automática de ejercicios de
            programación."
          </p>
          <footer class="text-sm">Ismael Díaz Díaz</footer>
        </blockquote>
      </div>
    </div>

    {/* Panel Derecho (Formulario) */}
    <div class="lg:p-8">
      <div class="absolute right-4 top-4 md:right-8 md:top-8">
        <LanguageSelector client:load />
      </div>

      <div
        class="mx-auto flex w-full flex-col justify-center space-y-6 sm:w-87.5">
        <div class="flex flex-col space-y-2 text-center">
          <h1 class="text-2xl font-semibold tracking-tight">Bienvenido</h1>
        </div>

        <LoginForm client:load />
      </div>
    </div>
  </div>
</Layout>
