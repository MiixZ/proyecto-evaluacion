### Test 5: Factorial (Python) - Múltiples test cases
POST {{execution_engine_url}}/execute HTTP/1.1
Content-Type: application/json
X-Api-Key: {{api_key}}

{
  "id": "exec-test-005",
  "exerciseId": "ex-factorial",
  "submissionId": "sub-005",
  "code": "def factorial(n):\n    if n == 0:\n        return 1\n    return n * factorial(n - 1)\n\nn = int(input())\nprint(factorial(n))",
  "language": "python",
  "testCases": [
    {
      "id": "tc-1",
      "input": "5",
      "expectedOutput": "120",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": false
    },
    {
      "id": "tc-2",
      "input": "0",
      "expectedOutput": "1",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": false
    },
    {
      "id": "tc-3",
      "input": "10",
      "expectedOutput": "3628800",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": true
    }
  ],
  "limits": {
    "timeLimitSeconds": 5,
    "memoryLimitMb": 256
  },
  "createdAt": "2025-12-18T11:44:00Z"
}

### Test 6: Número par o impar (Python)
POST {{execution_engine_url}}/execute HTTP/1.1
Content-Type: application/json
X-Api-Key: {{api_key}}

{
  "id": "exec-test-006",
  "exerciseId": "ex-par-impar",
  "submissionId": "sub-006",
  "code": "def es_par(n):\n    return n % 2 == 0\n\nn = int(input())\nif es_par(n):\n    print('par')\nelse:\n    print('impar')",
  "language": "python",
  "testCases": [
    {
      "id": "tc-1",
      "input": "4",
      "expectedOutput": "par",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": false
    },
    {
      "id": "tc-2",
      "input": "7",
      "expectedOutput": "impar",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": false
    },
    {
      "id": "tc-3",
      "input": "0",
      "expectedOutput": "par",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": true
    }
  ],
  "limits": {
    "timeLimitSeconds": 5,
    "memoryLimitMb": 256
  },
  "createdAt": "2025-12-18T11:44:00Z"
}

