###############################################################################
# CONFIGURACIÓN DE VARIABLES
###############################################################################

@backend_url = http://localhost:3000
@execution_engine_url = http://localhost:3001
@api_key = tu-api-key-secreta-aqui

###############################################################################
# 1. HEALTH CHECKS
###############################################################################

### Backend - Health Check
GET {{backend_url}}/health HTTP/1.1

### Execution Engine - Health Check
GET {{execution_engine_url}}/health HTTP/1.1
X-Api-Key: {{api_key}}

### Execution Engine - Stats
GET {{execution_engine_url}}/stats HTTP/1.1
X-Api-Key: {{api_key}}

###############################################################################
# 2. EXECUTION ENGINE - PRUEBAS DIRECTAS
###############################################################################

### Test 1: Suma básica (Python) - ACEPTADO
POST {{execution_engine_url}}/execute HTTP/1.1
Content-Type: application/json
X-Api-Key: {{api_key}}

{
  "id": "exec-test-001",
  "exerciseId": "ex-suma-basica",
  "submissionId": "sub-001",
  "code": "def suma(a, b):\n    return a + b\n\na = int(input())\nb = int(input())\nprint(suma(a, b))",
  "language": "python",
  "testCases": [
    {
      "id": "tc-1",
      "input": "2\n3",
      "expectedOutput": "5",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": false
    },
    {
      "id": "tc-2",
      "input": "10\n20",
      "expectedOutput": "30",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": false
    },
    {
      "id": "tc-3",
      "input": "-5\n5",
      "expectedOutput": "0",
      "timeLimit": 5,
      "memoryLimit": 256,
      "isHidden": true
    }
  ],
  "limits": {
    "timeLimitSeconds": 5,
    "memoryLimitMb": 256,
    "cpuShares": 1024,
    "maxProcesses": 100
  },
  "createdAt": "2025-12-18T11:44:00Z"
}

