@baseUrl = http://localhost:4000
@contentType = application/json

# ==========================================
# 0. VARIABLES GLOBALES (Estáticas)
# ==========================================
@admin_email = admin@university.edu
@admin_password = <<contraseña_admin>>

@teacher_email = profesor8@universidad.edu
@teacher_password = <<contraseña_profesor>>

@student1_email = alumna1@universidad.edu
@student2_email = alumna2@universidad.edu
@student_password = <<contraseña_alumna>>
# ==========================================
# 1. AUTENTICACIÓN (INICIO DE SESIÓN)
# ==========================================

### 1.1 Login ADMIN
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}" 
}

### 1.2 Login PROFESOR
# @name loginTeacher
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
    "email": "{{teacher_email}}",
    "password": "{{teacher_password}}"
}

### 1.3 Login ESTUDIANTE 1
# @name loginStudent1
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
    "email": "{{student1_email}}",
    "password": "{{student_password}}"
}

### 1.4 Login ESTUDIANTE 2
# @name loginStudent2
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
    "email": "{{student2_email}}",
    "password": "{{student_password}}"
}


# ==========================================
# 2. ESTRUCTURA ACADÉMICA (Admin)
# ==========================================

### 2.1 Crear Titulación (Degree)
# @name createDegree
POST {{baseUrl}}/api/v1/degrees
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: {{contentType}}

{
    "name": "Grado en Ingeniería de Software",
    "code": "GIS-2024",
    "durationYears": 4,
    "totalCredits": 240
}

### 2.2 Crear Asignatura (Subject)
# @name createSubject
POST {{baseUrl}}/api/v1/subjects
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: {{contentType}}

{
    "degreeId": "{{createDegree.response.body.data.id}}",
    "name": "Programación Concurrente",
    "code": "PRG-CON",
    "credits": 6,
    "semester": 2
}

### 2.3 Crear Curso Académico (Course)
# @name createCourse
POST {{baseUrl}}/api/v1/courses
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: {{contentType}}

{
    "subjectId": "{{createSubject.response.body.data.id}}",
    "academicYear": "2024-2025",
    "semester": 2,
    "status": "active",
    "startDate": "2025-01-01",
    "endDate": "2025-06-30"
}


# ==========================================
# 3. GESTIÓN DE AULA E IMPORTACIÓN (Profesor)
# ==========================================

### 3.1 Crear Grupo de Prácticas
# @name createGroup
POST {{baseUrl}}/api/v1/groups
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{
    "courseId": "{{createCourse.response.body.data.id}}",
    "name": "Grupo Laboratorio B",
    "capacity": 30
}

### 3.2 IMPORTACIÓN MASIVA DE ALUMNOS (CSV)
# @name importStudents
POST {{baseUrl}}/api/v1/groups/{{createGroup.response.body.data.id}}/import
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{
    "csvContent": "DNI,Nombre,Apellido,Email\n1111A,Pepito,Grillo,pepito.grillo@test.com\n2222B,Ana,Lopez,ana.lopez@test.com"
}

### 3.3 Crear Temario (Syllabus)
# @name createSyllabus
POST {{baseUrl}}/api/v1/syllabi
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{
    "courseId": "{{createCourse.response.body.data.id}}",
    "title": "Módulo 1: Threads en Python",
    "description": "Ejercicios básicos de hilos",
    "orderIndex": 1
}

### 3.4 Crear Ejercicio de Programación
# @name createExercise
POST {{baseUrl}}/api/v1/exercises
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{
  "syllabusId": "{{createSyllabus.response.body.data.id}}",
  "title": "Suma Paralela (Simulada)",
  "description": "Lee dos números y sumalos. (Ejercicio de prueba)",
  "difficulty": "intermediate",
  "language": "python",
  "points": 100,
  "testCases": [
    { "input": "10\n20", "expectedOutput": "30", "isHidden": false },
    { "input": "-5\n5", "expectedOutput": "0", "isHidden": true }
  ],
  "limits": { "timeLimitSeconds": 1, "memoryLimitMb": 64 }
}

### 3.5 Publicar Ejercicio
PATCH {{baseUrl}}/api/v1/exercises/{{createExercise.response.body.data.id}}/publish
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{ "isPublished": true }


# ==========================================
# 4. FLUJO DEL ESTUDIANTE (Usuario Importado)
# ==========================================

### 4.1 Login del Estudiante Importado
# Usamos la contraseña generada automáticamente en la importación CSV
# @name loginImportedStudent
POST {{baseUrl}}/api/auth/login
Content-Type: {{contentType}}

{
    "email": "pepito.grillo@test.com",
    "password": "csv_import_pepito.grillo@test.com"
}

### 4.2 Estudiante Consulta su Progreso (Dashboard)
GET {{baseUrl}}/api/v1/dashboard/student/progress?courseId={{createCourse.response.body.data.id}}
Authorization: Bearer {{loginImportedStudent.response.body.data.token}}
Content-Type: {{contentType}}

### 4.3 Estudiante Realiza un Envío (Submission)
# @name submitCode
POST {{baseUrl}}/api/v1/submissions
Authorization: Bearer {{loginImportedStudent.response.body.data.token}}
Content-Type: {{contentType}}

{
    "exerciseId": "{{createExercise.response.body.data.id}}",
    "courseId": "{{createCourse.response.body.data.id}}",
    "language": "python",
    "code": "import sys\n\nlines = sys.stdin.readlines()\na = int(lines[0])\nb = int(lines[1])\nprint(a + b)"
}


# ==========================================
# 5. EVALUACIÓN Y GESTIÓN (Profesor)
# ==========================================

### 5.1 Profesor consulta métricas del curso (Dashboard)
GET {{baseUrl}}/api/v1/dashboard/analytics/exercises?courseId={{createCourse.response.body.data.id}}
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

### 5.2 Profesor da Feedback Manual
POST {{baseUrl}}/api/v1/feedback
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{
    "submissionId": "{{submitCode.response.body.data.id}}",
    "content": "Buena implementación del manejo de entrada estándar.",
    "scoreAdjustment": 5,
    "visibility": "public"
}

### 5.3 Profesor revisa reporte de plagio (Simulación)
POST {{baseUrl}}/api/v1/plagiarism
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{
    "submissionId": "{{submitCode.response.body.data.id}}",
    "comparedWithSubmissionId": "{{submitCode.response.body.data.id}}", 
    "similarityPercent": 100, 
    "plagiarismType": "internal",
    "isFlagged": false,
    "notes": "Autocomparación de prueba"
}

### 5.4 Profesor Exporta los datos de un envío
POST {{baseUrl}}/api/v1/exports
Authorization: Bearer {{loginTeacher.response.body.data.token}}
Content-Type: {{contentType}}

{
    "submissionId": "{{submitCode.response.body.data.id}}",
    "format": "csv",
    "purpose": "analysis"
}


# ==========================================
# 6. AUDITORÍA Y SEGURIDAD (Admin)
# ==========================================

### 6.1 Admin consulta el Log de Auditoría
GET {{baseUrl}}/api/v1/audit?limit=50
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: {{contentType}}

### 6.2 Admin filtra auditoría por acción (CREATE_EXERCISE)
GET {{baseUrl}}/api/v1/audit?action=CREATE_EXERCISE
Authorization: Bearer {{loginAdmin.response.body.data.token}}
Content-Type: {{contentType}}