# BACKEND EVALUACIÓN PLATFORM - CONFIGURACIÓN DE ENTORNO
# Copia este archivo como `.env` y ajusta los valores para tu entorno local

# =============================================================================
# SERVER
# =============================================================================
PORT=3000
NODE_ENV=development

# =============================================================================
# DATABASE (MySQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=evaluacion_user
DB_PASSWORD=evaluacion_password
DB_NAME=evaluacion_platform

# Database Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY=0

# Connection Retry Strategy (exponential backoff)
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=1000
DB_QUERY_TIMEOUT_MS=30000

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
# Cambiar a un valor aleatorio de mínimo 32 caracteres en producción
JWT_SECRET=cambiar_en_produccion_minimo_32_caracteres_aleatorios_no_esto
# Token expiry: 3 horas
JWT_EXPIRY=3h

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGIN=http://localhost:3001

# =============================================================================
# LOGGING
# =============================================================================
# Niveles: error, warn, info, debug, trace
LOG_LEVEL=debug

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
# 1. NO subir este archivo a Git si contiene credenciales reales
# 2. Usar .env.example en el repositorio como referencia
# 3. El archivo .env es local y no debe ser versionado (.gitignore)
# 4. Para producción, usar variables de entorno del servidor (Docker, env vars, etc)
