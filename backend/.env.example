# BACKEND - .env.example
# Copia este archivo a `.env` y configura los valores para tu entorno.

# --- SERVER ---
PORT=4000
NODE_ENV=development

# --- DATABASE (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=evaluacion_user
DB_PASSWORD=changeme
DB_NAME=evaluacion_platform

# Pooling / retry
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY=0
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=1000
DB_QUERY_TIMEOUT_MS=30000

# --- AUTH / JWT ---
# Use a strong random value (min 32 chars) in production
JWT_SECRET=change_me_to_a_long_random_value_min_32_chars
JWT_EXPIRY=7d

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- LOGGING ---
LOG_LEVEL=info

# --- EXECUTION ENGINE ---
EXECUTION_ENGINE_URL=http://localhost:3001
EXECUTION_ENGINE_API_KEY=

# --- SMTP (opcional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plataforma Evaluación" <noreply@example.com>

# Notas:
# - No subas credenciales reales al repositorio.
# - Ajusta los valores en producción (securiza JWT, DB credentials y SMTP).

# --- Extras (comentadas) ---
# Sentry / monitoring examples
# SENTRY_DSN=

# Redis (si se usa para sesiones / cache)
# REDIS_URL=redis://localhost:6379

# Opciones DB TLS/SSL
# DB_SSL=true
# DB_SSL_CA_PATH=/path/to/ca.pem
