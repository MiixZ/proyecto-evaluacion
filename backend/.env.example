# ==================== SERVER ====================
PORT=3000
NODE_ENV=development

# ==================== DATABASE ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=evaluacion_user
DB_PASSWORD=evaluacion_password
DB_NAME=evaluacion_platform

# Pool Configuration
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
DB_WAIT_FOR_CONNECTIONS=true
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY=0

# Retry Strategy
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=1000
DB_QUERY_TIMEOUT_MS=30000

# ==================== JWT ====================
# IMPORTANTE: En producción, cambiar a una cadena aleatoria de 32+ caracteres
JWT_SECRET=cambiar_en_produccion_minimo_32_caracteres_aleatorios_no_esto
JWT_EXPIRY=7d

# ==================== AUTHGEAR ====================
# URL base de Authgear
AUTHGEAR_ENDPOINT=http://localhost:9000

# Client ID y Secret (obten del admin panel de Authgear)
AUTHGEAR_CLIENT_ID=your_client_id_here
AUTHGEAR_CLIENT_SECRET=your_client_secret_here

# API Key para operaciones administrativas
AUTHGEAR_API_KEY=your_api_key_here

# Webhook Secret (mínimo 32 caracteres en producción)
AUTHGEAR_WEBHOOK_SECRET=cambiar_webhook_secret_32_caracteres_minimo

# Cache TTL para tokens (en ms)
# Default: 3600000 (1 hora)
TOKEN_CACHE_TTL=3600000

# ==================== CORS ====================
# Lista de orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# ==================== LOGGING ====================
# Niveles: error, warn, info, debug, trace
LOG_LEVEL=debug
